#!/bin/sh
# Tool-agnostic LOCAL gate (opt-in). Enable once per clone:
#   git config core.hooksPath .githooks
#
# This is the shared enforcement every coding tool passes through, because every
# tool commits through git — Claude Code, Codex, Gemini/Antigravity, Copilot,
# Cursor, or a human. It runs the same structural gate used by CI: context-lint.
#
# Scoped: only fires when the commit actually stages AI-context files, so
# code-only commits stay frictionless.

changed=$(git diff --cached --name-only)
if printf '%s\n' "$changed" | grep -Eq '(^|/)AGENTS\.md$|(^|/)CLAUDE\.md$|^\.mcp\.json$|^docs/(ai|conventions|architecture)/|^\.agents/|^\.claude/skills/|^scripts/(context-lint|sync-claude-shims|sync-skills)\.mjs$|^\.github/copilot-instructions\.md$'; then
  echo "[pre-commit] AI-context files staged — running context-lint"
  bun run context:lint || {
    echo "[pre-commit] AI-context gate failed. Fix, or bypass with --no-verify (CI will still enforce)."
    exit 1
  }
fi
