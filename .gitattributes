# Normalize line endings: store LF in the repo, check out LF on all platforms.
# Prevents spurious CRLF/LF "modified" noise across editors and tools.
* text=auto eol=lf

# Bun lockfile
bun.lock text eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
