# Normalize all text files to LF in the repository AND on checkout.
# This overrides per-user `core.autocrlf`, so generated docs (the ADR register in
# docs/adr/README.md and workspace manifests)
# and scripts stay byte-stable across platforms. Without this, a Windows checkout
# (autocrlf=true) re-materializes Markdown as CRLF and the `--check` gates in
# scripts/context-lint.mjs / sync-skills.mjs can report false drift.
* text=auto eol=lf

# Shell scripts must stay LF regardless of platform.
*.sh text eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.mp4 binary
*.webm binary
*.wasm binary
