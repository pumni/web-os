{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["src/**/*.{ts,tsx,js,mjs}", "eslint.config.mjs", "tsconfig.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig.json", "tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.ts", "tsconfig.json"]
    },
    "format": {
      "inputs": ["src/**/*.{ts,tsx,js,mjs,css,json,md}", ".prettierrc", ".prettierignore"]
    }
  }
}
