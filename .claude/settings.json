{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-edited-file.mjs"],
            "timeout": 60,
            "statusMessage": "prettier (edited file)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ai-context-stop-gate.mjs"],
            "timeout": 120,
            "statusMessage": "context:lint (context files)"
          }
        ]
      }
    ]
  }
}
