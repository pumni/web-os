{
  "name": "web-os",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "next": "16.2.9",
      "typescript": "^6",
      "server-only": "^0.0.1",
      "zod": "^4.4.3",
      "eslint": "^9",
      "lucide-react": "^1.17.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "react-hook-form": "^7.78.0",
      "@supabase/ssr": "^0.12.0",
      "@supabase/supabase-js": "^2.108.1",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@types/node": "^22",
      "zustand": "^5.0.14",
      "@tanstack/react-query": "^5.101.0",
      "@hookform/resolvers": "^5.4.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.6.0",
      "motion": "^12.40.0",
      "radix-ui": "^1.5.0",
      "vitest": "^4.1.8",
      "@playwright/test": "^1.60.0",
      "@testing-library/react": "^16.3.2",
      "jsdom": "^29.1.1",
      "@dnd-kit/core": "^6.3.1",
      "@dnd-kit/sortable": "^10.0.0",
      "@dnd-kit/utilities": "^3.2.2",
      "@vidstack/react": "^1.15.6",
      "hls.js": "^1.6.16",
      "react-easy-crop": "^6.0.2",
      "match-sorter": "^8.3.0",
      "@tailwindcss/postcss": "^4",
      "tw-animate-css": "^1.0.3",
      "babel-plugin-react-compiler": "^1.0.0",
      "@testing-library/jest-dom": "^6.9.1",
      "typescript-eslint": "^8",
      "eslint-config-next": "16.2.9",
      "prettier": "^3.8.4",
      "prettier-plugin-tailwindcss": "^0.8.0",
      "tailwind-lint": "^0.12.0",
      "tailwindcss": "^4",
      "turbo": "2.9.18"
    }
  },
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "format": "turbo format",
    "ai:check": "bun scripts/check-ai-context.mjs && bun run ai:tw",
    "ai:tw": "tailwind-lint --config apps/web/src/app/globals.css \"apps/web/**/*.{ts,tsx}\" \"packages/ui/src/**/*.{ts,tsx}\"",
    "ai:tw:fix": "tailwind-lint --config apps/web/src/app/globals.css \"apps/web/**/*.{ts,tsx}\" \"packages/ui/src/**/*.{ts,tsx}\" --fix",
    "ai:secrets": "bun scripts/check-secrets.mjs",
    "ai:review:static": "bun scripts/check-review-gate-rules.mjs",
    "ai:eval": "bun scripts/run-ai-evals.mjs",
    "ai:graph:sync": "bun scripts/sync-project-graph.mjs",
    "ai:skills:sync": "bun scripts/sync-skills.mjs",
    "ps:check": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/check.ps1",
    "ps:premerge": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/check.ps1 -Gate premerge",
    "ps:search": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/search.ps1",
    "ai:local": "bun run ai:check && bun run typecheck",
    "ai:premerge": "bun run ai:check && bun run ai:eval && bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "bun run scripts/clean.mjs"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tailwind-lint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.14"
}
