{
  "name": "web-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vidstack/react": "^1.15.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-storybook": "10.4.6",
    "hls.js": "^1.6.16",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.23.0",
    "match-sorter": "^8.3.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.1.0",
    "react-hook-form": "^7.80.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "storybook": "10.4.6",
    "tailwind-lint": "^0.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "turbo": "2.10.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "turbo run dev --filter=web",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "catalog:dev": "turbo run dev --filter=catalog",
    "catalog:build": "turbo run catalog:build",
    "catalog:lint": "turbo run catalog:lint",
    "catalog:typecheck": "turbo run catalog:typecheck",
    "ai:check": "bun scripts/check-ai-context.mjs && bun run ai:tw",
    "ai:tw": "tailwind-lint --config apps/web/src/app/globals.css \"apps/web/**/*.{ts,tsx}\" \"packages/ui/src/**/*.{ts,tsx}\"",
    "ai:eval": "bun scripts/run-ai-evals.mjs",
    "ai:eval:behavioral": "bun scripts/run-behavioral-evals.mjs",
    "ai:metrics": "bun scripts/ai-metrics.mjs",
    "ai:graph:sync": "bun scripts/sync-project-graph.mjs",
    "ai:adr:sync": "bun scripts/sync-adr-register.mjs",
    "ai:skills:sync": "bun scripts/sync-skills.mjs",
    "ai:premerge": "bun run ai:check && bun run ai:eval && turbo run lint typecheck test build",
    "clean": "bun run scripts/clean.mjs"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tailwind-lint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.14"
}
