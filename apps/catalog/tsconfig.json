{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Relaxed from the strict base: React component optional props (e.g.
    // ref, asChild) are not exactOptionalPropertyTypes-clean. Same pattern
    // as apps/web — library packages keep it enabled.
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["react", "react-dom"]
  },
  "include": ["src", ".storybook"]
}
