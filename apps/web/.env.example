NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-or-secret-key

# Jellyfin media server (Cinema feature)
# Public HTTPS base the BROWSER connects to directly for HLS streaming.
# Expose Jellyfin over Tailscale Serve (tailnet) or Funnel (public) so the cert
# is valid: `tailscale serve --bg --https=443 localhost:8096`.
NEXT_PUBLIC_JELLYFIN_URL=https://your-host.your-tailnet.ts.net
# Server-side base URL (may equal the public one or an internal tailnet address).
JELLYFIN_URL=https://your-host.your-tailnet.ts.net
# Admin API key — SERVER-ONLY, never sent to the browser. Library browsing only.
JELLYFIN_API_KEY=replace-with-jellyfin-admin-api-key
# Dedicated low-privilege Jellyfin user (library read-only). The server mints a
# scoped AccessToken from these for the player; the admin key stays server-side.
JELLYFIN_USER=replace-with-streaming-user
JELLYFIN_PASSWORD=replace-with-streaming-user-password
