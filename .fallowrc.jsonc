{
  "$schema": "https://fallow.dev/schema.json",

  // ─── Monorepo workspace layout ────────────────────────────────────────────
  // Tells fallow the package globs so per-package health, scoped dead-code,
  // and cross-package boundary checks all activate correctly.
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },

  // ─── Globally ignored files ───────────────────────────────────────────────
  // Generated types: regenerated by `bun run supabase gen types`, not authored.
  "ignorePatterns": [
    "packages/supabase/src/types.ts"
  ],

  // ─── Explicit entry points ────────────────────────────────────────────────
  // AI/CI scripts not referenced from package.json scripts (so not
  // auto-detected by the script-multiplexer analysis). Listed explicitly to
  // avoid false-positive unused-file/export findings on their imports.
  "entry": [
    "scripts/context-lint.mjs",
    "scripts/check-context-drift.mjs",
    "scripts/check-feature-boundary.mjs",
    "scripts/check-review-gate-rules.mjs",
    "scripts/check-secrets.mjs",
    "scripts/review-gate-rules.mjs",
    "scripts/sync-nav-table.mjs"
  ],

  // ─── Public package surface ───────────────────────────────────────────────
  // Marks workspace packages whose exports are consumed outside the monorepo.
  // Combined with private-type-leaks: "warn" below this enforces API hygiene.
  "publicPackages": [
    "@pumni/auth",
    "@pumni/config",
    "@pumni/env",
    "@pumni/features",
    "@pumni/supabase",
    "@pumni/test-utils",
    "@pumni/ui",
    "@pumni/validators"
  ],

  // ─── Architecture boundaries ──────────────────────────────────────────────
  // Custom zones matching the actual monorepo layout under apps/web/src/.
  // The built-in feature-sliced preset expects src/{app,features,shared} at
  // root — incompatible with the apps/web/src/ monorepo prefix here.
  //
  // Enforces:
  //   packages     → isolated sub-packages; imports allowed along the project dependency graph only
  //                  (Auth -> Supabase -> Env, Ui -> Config/TestUtils).
  //   shared       → can import packages and app-registry (navigation registry).
  //   features     → can import shared + packages; features cannot import each other (autoDiscover-enforced).
  //   app          → can import app-shell, features, shared, packages, and app-registry (entry layer).
  //   app-registry → specific exception for nav-registry.ts, allowing it to import app pages.
  "boundaries": {
    "zones": [
      {
        "name": "packages",
        "autoDiscover": ["packages"]
      },
      {
        "name": "app-registry",
        "patterns": ["apps/web/src/shared/components/app-shell/nav-registry.ts"]
      },
      {
        "name": "shared",
        "patterns": ["apps/web/src/shared/**", "!apps/web/src/shared/components/app-shell/nav-registry.ts"]
      },
      {
        "name": "features",
        "autoDiscover": ["apps/web/src/features"]
      },
      {
        "name": "app",
        "patterns": ["apps/web/src/app/**"]
      }
    ],
    "rules": [
      {
        "from": "app",
        "allow": ["features", "shared", "packages", "app-registry"]
      },
      {
        "from": "app-registry",
        "allow": ["app", "features", "shared", "packages"]
      },
      {
        "from": "features",
        "allow": ["shared", "packages"]
      },
      {
        "from": "shared",
        "allow": ["packages", "app-registry"]
      },
      {
        "from": "packages/auth",
        "allow": ["packages/supabase"]
      },
      {
        "from": "packages/supabase",
        "allow": ["packages/env"]
      },
      {
        "from": "packages/ui",
        "allow": ["packages/config", "packages/test-utils"]
      }
    ]
  },

  // ─── Security category opt-ins ────────────────────────────────────────────
  // hardcoded-secret and secret-to-network are include-required (off unless
  // explicitly listed). Enabling both surfaces leaked keys and secrets sent
  // over the wire — critical for this project's P0 security mandates.
  "security": {
    "categories": {
      "include": ["hardcoded-secret", "secret-to-network"]
    }
  },

  // ─── Duplication detection ────────────────────────────────────────────────
  "duplicates": {
    "enabled": true,
    "mode": "mild",         // AST-based; catches renamed-literal clones
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 2,
    "ignoreDefaults": true, // filter trivially repeated atomic calls
    "ignoreImports": true,
    "skipLocal": false,
    "crossLanguage": false
  },

  // ─── Complexity thresholds ────────────────────────────────────────────────
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive":  15,
    "maxCrap":       30.0,
    "maxUnitSize":   60,    // configurable since v3.2.0; default is 60
    "thresholdOverrides": [
      {
        "files": ["**/*.test.*", "**/*.spec.*"],
        "maxUnitSize": 500,
        "reason": "Test describe/it blocks routinely exceed 60 LOC; complexity checks remain active"
      },
      {
        "files": ["scripts/**"],
        "maxUnitSize": 200,
        "reason": "CI/AI scripts contain procedural functions"
      }
    ]
  },

  // ─── Rule severities ─────────────────────────────────────────────────────
  "rules": {
    // --- Next.js / Server Action rules (framework auto-gates) ---------------
    "unused-server-actions":          "warn",
    "unused-load-data-keys":          "warn",
    "dev-dependencies-in-production": "warn",  // default warn since v3.1.0

    // --- Client/server boundary (Next.js App Router) — ERRORS ---------------
    // These match P0 mandates in AGENTS.md: server-only code must never reach
    // the client bundle; "use client"/"use server" directives must be correct.
    "invalid-client-export":          "error",
    "mixed-client-server-barrel":     "error",
    "misplaced-directive":            "error",
    "security-client-server-leak":    "error",  // ↑ was "off"; P0 mandate

    // --- Security (opt-in; activated by security.categories.include above) --
    // security-sink surfaces reachable dangerous patterns (SQL injection,
    // XSS, path traversal). "warn" so agents see candidates without
    // blocking CI until triaged and hardened.
    "security-sink":                  "warn",   // ↑ was "off"

    // --- API hygiene ---------------------------------------------------------
    // private-type-leaks fires on ALL exports (not only publicPackages), so
    // it flags component Props types in features/ and app/ as well — too noisy
    // for feature-internal components. Keep off; enable per-package if needed:
    //   "overrides": [{ "files": ["packages/**"], "rules": { "private-type-leaks": "warn" } }]
    "private-type-leaks":             "off",

    // --- Suppression governance (new in v3.3.0 era) --------------------------
    // fallow suppressions command now provides a governance inventory; requiring
    // reasons makes every intentional suppression self-documenting.
    "require-suppression-reason":     "warn",   // ↑ was "off"

    // --- CSS / Tailwind v4 token hygiene ------------------------------------
    // Project uses Tailwind v4 (@tailwindcss/vite). Token drift and broken
    // CSS-variable references are the main design-system erosion signals.
    "css-token-drift":                "warn",   // ↑ was "off"; Tailwind v4 tokens
    "css-broken-reference":           "warn",   // ↑ was "off"; undefined --vars

    // Structural CSS checks kept off: too noisy without baseline triage.
    "css-duplicate-block":            "off",
    "css-selector-complexity":        "off",
    "css-dead-surface":               "off",

    // --- Opt-in / experimental (kept off until baseline triage done) --------
    "coverage-gaps":                  "off",   // needs Istanbul JSON input
    "feature-flags":                  "off",
    "prop-drilling":                  "off",
    "thin-wrapper":                   "off",
    "duplicate-prop-shape":           "off"
  },

  // ─── Ignored Dependencies ──────────────────────────────────────────────────
  // Exclude @pumni/test-utils which is listed in packages/ui devDependencies
  // but only imported reflectively in apps/web tests.
  "ignoreDependencies": [
    "@pumni/test-utils"
  ],

  // ─── Audit (PR / changed-file gate) ──────────────────────────────────────
  // gate: "new-only" means only findings introduced by the current change
  // block CI; pre-existing findings are informational. This is the correct
  // staged-adoption strategy per the fallow compliance guide.
  // css: true enables Tailwind v4 token-drift and broken-reference checks
  // on changed CSS/TSX files; cssDeep scans the full token graph for context.
  "audit": {
    "gate":    "new-only",
    "css":     true,
    "cssDeep": true
  },

  // ─── Production mode per analysis ────────────────────────────────────────
  // health: true → complexity analysis excludes test/dev files, giving
  //   a clean signal on production code. Test files still get full checks
  //   but their results are separated in the output.
  // deadCode/dupes: false → full-tree analysis (test files included) so
  //   unused exports and clone families in test helpers are visible.
  "production": {
    "deadCode": false,
    "health":   true,    // ↑ was false
    "dupes":    false
  }
}
