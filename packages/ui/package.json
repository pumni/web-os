{
  "name": "@pumni/ui",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./styles/*": "./src/styles/*",
    "./form": "./src/components/form/index.ts",
    "./overlay": "./src/components/overlay/index.ts",
    "./layout": "./src/components/layout/index.ts",
    "./feedback": "./src/components/feedback/index.ts",
    "./identity": "./src/components/identity/index.ts",
    "./os": "./src/components/os/index.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "lint": "bunx eslint .",
    "typecheck": "bunx tsc --noEmit",
    "generate-exports": "bun run scripts/generate-exports.ts",
    "export-dtcg": "bun run scripts/export-dtcg.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "match-sorter": "catalog:",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react-hook-form": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@pumni/config": "workspace:*",
    "@pumni/test-utils": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "apca-w3": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
